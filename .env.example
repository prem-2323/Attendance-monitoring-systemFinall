# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
DATABASE_NAME=attendance-monitoring-system

# Face Recognition Configuration
FACE_MATCH_THRESHOLD=0.55
FACE_CONFIDENCE_THRESHOLD=0.85

# Attendance Rules
WORK_START_HOUR=9
WORK_START_MINUTE=0
LATE_THRESHOLD_MINUTES=30

# Office GPS Geofence Box (polygon — attendance allowed ONLY inside this box)
OFFICE_NAME=Head Office Block
OFFICE_ADDRESS=Office Campus Premises, Tamil Nadu
OFFICE_LAT=11.27037707675975
OFFICE_LNG=77.60352284059195
OFFICE_RADIUS_METERS=1000
OFFICE_GEOFENCE_POLYGON=11.270872464050166,77.60414913913843;11.269939620797608,77.60419457796888;11.26989802898974,77.60290714443924;11.270798193201482,77.60284050082124

# MongoDB Atlas Attendance Email Notification Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
MAIL_FROM=your-email@gmail.com
ADMIN_EMAIL=your-email@gmail.com
TIMEZONE=Asia/Kolkata
ATTENDANCE_CUTOFF=09:30
