# MongoDB Atlas (required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
DATABASE_NAME=attendance-monitoring-system

# Email notifications: OTP, attendance & absence alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
MAIL_FROM=your-email@gmail.com
ADMIN_EMAIL=your-email@gmail.com

# Attendance scheduler (defaults: Asia/Kolkata / 11:40)
TIMEZONE=Asia/Kolkata
ATTENDANCE_CUTOFF=11:40

# Deployment / CORS
# Local development can leave these as-is.
# On Render set CORS_ORIGINS to your Vercel URL(s), comma-separated.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# FRONTEND_URL=https://your-app.vercel.app
