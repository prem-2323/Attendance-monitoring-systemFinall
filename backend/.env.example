# ==============================================================================
# BACKEND ENVIRONMENT TEMPLATE (Render / Local)
# Copy to backend/.env and populate with your production values
# ==============================================================================

# MongoDB Atlas (required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
DATABASE_NAME=attendance-monitoring-system

# Server & Deployment Configuration
ENVIRONMENT=production
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
FRONTEND_URL=https://your-frontend.vercel.app

# Optional bootstrap accounts. Set NAME, EMAIL, and PASSWORD for a role to
# create that account when missing (including after reset). EMPLOYEE_ID
# defaults to EMAIL. Set passwords in Render/local environment settings; never
# commit production passwords to source control.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMPLOYEE_ID=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_DEPARTMENT=System Administration
BOOTSTRAP_MANAGER_NAME=
BOOTSTRAP_MANAGER_EMPLOYEE_ID=
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_MANAGER_PHONE=
BOOTSTRAP_MANAGER_DEPARTMENT=Engineering

# Biometric & Face Recognition Configuration
FACE_MATCH_THRESHOLD=0.55
FACE_CONFIDENCE_THRESHOLD=0.85

# Attendance Shift Rules
WORK_START_HOUR=11
WORK_START_MINUTE=25
LATE_THRESHOLD_MINUTES=15

# Office geofence boundary coordinates
OFFICE_NAME=Head Office Block
OFFICE_ADDRESS=Office Campus Premises, Tamil Nadu
OFFICE_LAT=11.27037707675975
OFFICE_LNG=77.60352284059195
OFFICE_RADIUS_METERS=1000
OFFICE_GEOFENCE_POLYGON=11.270872464050166,77.60414913913843;11.269939620797608,77.60419457796888;11.26989802898974,77.60290714443924;11.270798193201482,77.60284050082124

# Email & Automated Notification Service (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
MAIL_FROM=your-email@gmail.com
ADMIN_EMAIL=your-admin-email@gmail.com
ATTENDANCE_CUTOFF=11:40
