# ── Backend API ──────────────────────────────────────────────────────────────
# Local development: leave empty (Vite proxies /api to http://127.0.0.1:8000).
# Vercel production: set this to your Render service origin, WITHOUT /api.
# Example: https://attendance-monitoring-api.onrender.com
VITE_API_BASE_URL=

# ── Office fallback values ───────────────────────────────────────────────────
# These are only used before the live MongoDB settings load (or if the API is
# temporarily unavailable). The Admin Settings page / MongoDB is the source of
# truth at runtime.
VITE_OFFICE_NAME=Head Office Block
VITE_OFFICE_LAT=11.27037707675975
VITE_OFFICE_LNG=77.60352284059195
VITE_OFFICE_RADIUS_METERS=1000
VITE_OFFICE_GEOFENCE_POLYGON=11.270872464050166,77.60414913913843;11.269939620797608,77.60419457796888;11.26989802898974,77.60290714443924;11.270798193201482,77.60284050082124
