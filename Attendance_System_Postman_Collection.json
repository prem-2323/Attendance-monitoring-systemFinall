    {
      "name": "5. Forgot Password Flow (ForgotPasswordModal.tsx)",
      "item": [
        {
          "name": "Step 1: Request OTP Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code) {",
                  "    pm.collectionVariables.set('resetOtp', json.code);",
                  "    console.log('Saved OTP to variable: ' + json.code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"john.doe@company.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password/request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password", "request"]
            },
            "description": "Step 1: Generates OTP token and saves it in MongoDB Atlas reset_tokens collection. Saves token to collection variable {{resetOtp}}."
          },
          "response": []
        },
        {
          "name": "Step 2: Verify OTP Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"john.doe@company.com\",\n  \"code\": \"{{resetOtp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password", "verify"]
            },
            "description": "Step 2: Verifies submitted OTP against MongoDB Atlas."
          },
          "response": []
        },
        {
          "name": "Step 3: Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"john.doe@company.com\",\n  \"code\": \"{{resetOtp}}\",\n  \"newPassword\": \"myNewSecurePassword2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password/reset",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password", "reset"]
            },
            "description": "Step 3: Updates hashed password in MongoDB Atlas and burns the token."
          },
          "response": []
        },
        {
          "name": "Verify Login With New Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"john.doe@company.com\",\n  \"password\": \"myNewSecurePassword2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Verifies that the user can log in with their newly updated password."
          },
          "response": []
        }
      ]
    },
